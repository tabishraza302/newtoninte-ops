{
  "name": "@newtonite/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file ../.env src/index.ts",
    "start": "bun --env-file ../.env src/index.ts",
    "worker": "bun --env-file ../.env src/worker-main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun run vitest run",
    "test:watch": "bun --bun run vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file ../.env src/db/migrate.ts",
    "db:reset": "bun --env-file ../.env src/db/reset.ts",
    "seed": "bun --env-file ../.env src/seed.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "express": "^5.3.0",
    "supertest": "^7.3.1",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.2",
    "zod": "^3"
  }
}
