# Build context is the repository root; keep the image lean.

# Installed inside the image from the lockfile.
node_modules
**/node_modules

# Build output.
dist
**/dist
coverage
**/coverage
*.tsbuildinfo

# Local secrets / environment.
.env
.env.*
!.env.example

# VCS, worktrees and agent scratch.
.git
.gitignore
.worktrees

# Not needed at runtime.
docs
requirement

# Logs / editor noise.
*.log
.DS_Store
